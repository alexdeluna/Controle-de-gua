rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(residenceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/residencias/$(residenceId)/membros/$(request.auth.uid))
        && get(/databases/$(database)/documents/residencias/$(residenceId)/membros/$(request.auth.uid)).data.ativo == true;
    }

    // Cada usuário pode consultar apenas o próprio documento de membro.
    // A associação inicial é criada pelo responsável no Console do Firebase.
    match /residencias/{residenceId}/membros/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Configurações compartilhadas da residência.
    match /residencias/{residenceId}/configuracao/{documentId} {
      allow read, create, update: if isMember(residenceId);
      allow delete: if false;
    }

    // Histórico compartilhado: abastecimentos, transferências, medições e auditoria.
    match /residencias/{residenceId}/{collectionName}/{recordId} {
      allow read, create, update: if isMember(residenceId)
        && collectionName in ['abastecimentos', 'transferencias', 'medicoes', 'auditoria'];
      allow delete: if isMember(residenceId)
        && collectionName in ['abastecimentos', 'transferencias', 'medicoes', 'auditoria'];
    }

    // Bloqueia qualquer outro caminho não explicitamente autorizado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
